---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogCard from '../components/BlogCard.astro';
import CopyLink from '../components/CopyLink';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress';
import ScrollToTop from '../components/ScrollToTop.astro';
import ShareTelegram from '../components/ShareTelegram.astro';
import { CATEGORIES } from '../data/categories';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';

type RelatedPost = { title: string; description: string; slug: string; heroImage?: ImageMetadata; category?: string; pubDate: Date };

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: string;
	wordCount?: number;
	prevPost?: { title: string; slug: string };
	nextPost?: { title: string; slug: string };
	relatedPosts?: RelatedPost[];
};

const { title, description, seoTitle, seoDescription, pubDate, updatedDate, heroImage, readingTime, wordCount, category, faq, prevPost, nextPost, relatedPosts } = Astro.props;
const catDef = category ? CATEGORIES.find((c) => c.key === category) : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const metaTitle = seoTitle ?? title;
const metaDescription = seoDescription ?? description;

let imageURL: string | undefined;
if (heroImage) {
	const ogOpt = await getImage({
		src: heroImage,
		width: 1200,
		height: 630,
		fit: 'cover',
		format: 'jpeg',
		quality: 82,
	});
	imageURL = new URL(ogOpt.src, Astro.site).toString();
}

function formatDate(d: Date) {
	return d.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
}

const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": metaTitle,
	"description": metaDescription,
	"url": canonicalURL.toString(),
	...(imageURL && { "image": imageURL }),
	"datePublished": pubDate.toISOString(),
	"dateModified": (updatedDate ?? pubDate).toISOString(),
	...(catDef ? { "articleSection": catDef.title } : category && { "articleSection": category }),
	...(wordCount && { "wordCount": wordCount }),
	"author": {
		"@type": "Person",
		"name": AUTHOR_NAME,
		"url": new URL('/about/', Astro.site).toString()
	},
	"publisher": {
		"@type": "Organization",
		"name": SITE_TITLE,
		"url": Astro.site?.toString(),
		"logo": {
			"@type": "ImageObject",
			"url": new URL('/apple-touch-icon.png', Astro.site).toString()
		}
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": canonicalURL.toString()
	},
	"inLanguage": "ru-RU"
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Главная", "item": Astro.site?.toString() },
		{ "@type": "ListItem", "position": 2, "name": "Статьи", "item": new URL('/blog/', Astro.site).toString() },
		...(catDef
			? [{ "@type": "ListItem", "position": 3, "name": catDef.title, "item": new URL(`/blog/category/${catDef.slug}/`, Astro.site).toString() }]
			: []),
		{ "@type": "ListItem", "position": catDef ? 4 : 3, "name": title, "item": canonicalURL.toString() }
	]
};
const faqSchema =
	faq && faq.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": faq.map((item) => ({
					"@type": "Question",
					"name": item.q,
					"acceptedAnswer": {
						"@type": "Answer",
						"text": item.a,
					},
				})),
			}
		: null;
---

<html lang="ru">
	<head>
		<BaseHead
			title={`${metaTitle} — ${SITE_TITLE}`}
			description={metaDescription}
			image={heroImage}
			type="article"
			section={catDef?.title ?? category}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		>
			<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
			{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
		</BaseHead>
	</head>

	<body>
		<Header />
		<ReadingProgress client:load wordCount={wordCount} />
		<ScrollToTop />
		<main>
			<div class="article-top">
				<nav class="breadcrumbs" aria-label="Навигация">
					<ol>
						<li><a href="/">Главная</a></li>
						<li><a href="/blog/">Статьи</a></li>
						{catDef && (
							<li><a href={`/blog/category/${catDef.slug}/`}>{catDef.title}</a></li>
						)}
						<li aria-current="page">{title}</li>
					</ol>
				</nav>
				<div class="article-toolbar">
					<a href="/blog/" class="back-link">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M19 12H5M12 19l-7-7 7-7" />
						</svg>
						Все статьи
					</a>
					<div class="toolbar-actions">
						<ShareTelegram url={canonicalURL.toString()} text={title} />
						<CopyLink client:load />
					</div>
				</div>

				<header class="article-header">
					<div class="meta">
						{catDef && (
							<a href={`/blog/category/${catDef.slug}/`} class="article-cat-chip" style={`--cc: var(${catDef.varName});`}>
								{catDef.title}
							</a>
						)}
						<a href="/about/" class="author-link">{AUTHOR_NAME}</a>
						<span class="meta-sep">&middot;</span>
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">&middot; обновлено <FormattedDate date={updatedDate} /></span>
						)}
						{readingTime && (
							<span class="read-time">&middot; {readingTime}</span>
						)}
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>

				{heroImage && (
					<div class="hero-image">
						<Image width={960} height={480} src={heroImage} alt={title} loading="eager" fetchpriority="high" />
					</div>
				)}
			</div>

			<aside class="toc" aria-label="Содержание">
				<div class="toc-inner">
					<span class="toc-title">Содержание</span>
					<nav class="toc-nav" id="toc-nav"></nav>
				</div>
			</aside>

			<div class="article-content">
				<article>
					<details class="mobile-toc" id="mobile-toc" hidden>
						<summary class="mobile-toc-summary">
							<span>Содержание статьи</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
						</summary>
						<nav class="mobile-toc-nav" id="mobile-toc-nav"></nav>
					</details>

					<div class="prose">
						<slot />
					</div>

					{faq && faq.length > 0 && (
						<section class="faq-section" aria-label="Частые вопросы">
							<h2 class="faq-title">Частые вопросы</h2>
							<div class="faq-list">
								{faq.map((item) => (
									<details class="faq-item">
										<summary>{item.q}</summary>
										<p>{item.a}</p>
									</details>
								))}
							</div>
						</section>
					)}

					<section class="article-cta" aria-label="Поделиться и подписаться">
						<div class="article-cta-body">
							<span class="article-cta-kicker">ЭЙ АЙ ШИЗ · Telegram</span>
							<p>Понравился разбор? Подписывайся на <strong>@ai_shizz</strong> — там короткие заметки, ночные тесты vLLM и анонсы новых статей.</p>
						</div>
						<div class="article-cta-actions">
							<a href="https://t.me/ai_shizz" target="_blank" rel="noopener" class="cta-sub-btn">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
								Канал в Telegram
							</a>
							<ShareTelegram url={canonicalURL.toString()} text={title} />
							<CopyLink client:visible />
						</div>
					</section>

					{relatedPosts && relatedPosts.length > 0 && (
						<section class="related-posts" aria-label="Похожие статьи">
							<h2 class="related-title">Похожие статьи</h2>
							<div class="related-grid">
								{relatedPosts.map((p) => (
									<BlogCard
										title={p.title}
										description={p.description}
										date={formatDate(p.pubDate)}
										slug={p.slug}
										heroImage={p.heroImage}
										category={p.category}
									/>
								))}
							</div>
						</section>
					)}

					{(prevPost || nextPost) && (
						<nav class="post-nav">
							{prevPost ? (
								<a href={`/blog/${prevPost.slug}/`} class="nav-link nav-prev">
									<span class="nav-label">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
										Предыдущая
									</span>
									<span class="nav-title">{prevPost.title}</span>
								</a>
							) : <div />}
							{nextPost ? (
								<a href={`/blog/${nextPost.slug}/`} class="nav-link nav-next">
									<span class="nav-label">
										Следующая
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
									</span>
									<span class="nav-title">{nextPost.title}</span>
								</a>
							) : <div />}
						</nav>
					)}
				</article>
			</div>
		</main>
		<Footer />

		<script>
			function initCodeBlocks() {
				document.querySelectorAll('pre').forEach((pre) => {
					if (pre.parentElement?.classList.contains('code-block')) return;

					const code = pre.querySelector('code');
					const dataLang = pre.getAttribute('data-language') || '';
					const classAttr = code?.getAttribute('class') || '';
					const langMatch = classAttr.match(/language-(\w+)/);
					const lang = dataLang || (langMatch ? langMatch[1] : '');

					const wrapper = document.createElement('div');
					wrapper.className = 'code-block';

					const header = document.createElement('div');
					header.className = 'code-block-header';

					const langSpan = document.createElement('span');
					langSpan.className = 'code-block-lang';
					langSpan.textContent = lang || 'code';

					const copyBtn = document.createElement('button');
					copyBtn.className = 'code-copy-btn';
					copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Копировать`;

					copyBtn.addEventListener('click', async () => {
						const text = pre.querySelector('code')?.textContent || pre.textContent || '';
						await navigator.clipboard.writeText(text);
						copyBtn.classList.add('copied');
						copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Скопировано`;
						setTimeout(() => {
							copyBtn.classList.remove('copied');
							copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Копировать`;
						}, 2000);
					});

					header.appendChild(langSpan);
					header.appendChild(copyBtn);

					pre.parentNode!.insertBefore(wrapper, pre);
					wrapper.appendChild(header);
					wrapper.appendChild(pre);
				});
			}

		function initLightbox() {
			let overlay = document.getElementById('img-lightbox') as HTMLElement | null;
			if (!overlay) {
				overlay = document.createElement('div');
				overlay.id = 'img-lightbox';
				overlay.innerHTML = `
					<button class="lb-close" aria-label="Закрыть">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
					<div class="lb-wrap"><img /><div class="lb-caption"></div></div>
					<div class="lb-zoom-hint">Сведите/разведите пальцы для зума</div>
				`;
				document.body.appendChild(overlay);

				const wrap = overlay.querySelector('.lb-wrap') as HTMLElement;
				const lbImgEl = wrap.querySelector('img') as HTMLImageElement;
				const hint = overlay.querySelector('.lb-zoom-hint') as HTMLElement;

				let scale = 1;
				let panX = 0;
				let panY = 0;
				let startDist = 0;
				let startScale = 1;
				let startPanX = 0;
				let startPanY = 0;
				let startMidX = 0;
				let startMidY = 0;
				let singleStartX = 0;
				let singleStartY = 0;
				let singleDeltaY = 0;
				let isPinching = false;
				let isPanning = false;
				let hintShown = false;

				function applyTransform(anim = false) {
					if (anim) wrap.style.transition = 'transform 0.25s ease';
					else wrap.style.transition = 'none';
					wrap.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
				}

				function resetZoom(anim = true) {
					scale = 1; panX = 0; panY = 0;
					applyTransform(anim);
					overlay!.style.background = '';
				}

				const closeLb = () => {
					overlay!.classList.remove('active');
					document.body.style.overflow = '';
					setTimeout(() => resetZoom(false), 300);
				};

				overlay.querySelector('.lb-close')!.addEventListener('click', (e) => {
					e.stopPropagation();
					closeLb();
				});
				overlay.addEventListener('click', (e) => {
					if ((e.target as HTMLElement).closest('.lb-wrap')) return;
					closeLb();
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && overlay!.classList.contains('active')) closeLb();
				});

				function dist(t: TouchList) {
					const dx = t[0].clientX - t[1].clientX;
					const dy = t[0].clientY - t[1].clientY;
					return Math.sqrt(dx * dx + dy * dy);
				}
				function mid(t: TouchList) {
					return { x: (t[0].clientX + t[1].clientX) / 2, y: (t[0].clientY + t[1].clientY) / 2 };
				}

				wrap.addEventListener('touchstart', (e) => {
					if (e.touches.length === 2) {
						isPinching = true;
						isPanning = false;
						startDist = dist(e.touches);
						startScale = scale;
						const m = mid(e.touches);
						startMidX = m.x; startMidY = m.y;
						startPanX = panX; startPanY = panY;
						if (!hintShown) { hint.style.opacity = '0'; hintShown = true; }
					} else if (e.touches.length === 1) {
						isPinching = false;
						singleStartX = e.touches[0].clientX;
						singleStartY = e.touches[0].clientY;
						singleDeltaY = 0;
						startPanX = panX; startPanY = panY;
						isPanning = scale > 1.05;
					}
					wrap.style.transition = 'none';
				}, { passive: true });

				wrap.addEventListener('touchmove', (e) => {
					if (isPinching && e.touches.length === 2) {
						e.preventDefault();
						const d = dist(e.touches);
						const newScale = Math.min(5, Math.max(0.5, startScale * (d / startDist)));
						const m = mid(e.touches);
						panX = startPanX + (m.x - startMidX);
						panY = startPanY + (m.y - startMidY);
						scale = newScale;
						applyTransform();
					} else if (e.touches.length === 1 && !isPinching) {
						const dx = e.touches[0].clientX - singleStartX;
						const dy = e.touches[0].clientY - singleStartY;
						if (scale > 1.05) {
							e.preventDefault();
							panX = startPanX + dx;
							panY = startPanY + dy;
							applyTransform();
						} else {
							singleDeltaY = dy;
							const abs = Math.abs(singleDeltaY);
							const opacity = Math.max(0, 1 - abs / 300);
							wrap.style.transition = 'none';
							wrap.style.transform = `translateY(${singleDeltaY}px) scale(${1 - abs / 1500})`;
							overlay!.style.background = `rgba(0,0,0,${0.92 * opacity})`;
						}
					}
				}, { passive: false });

				wrap.addEventListener('touchend', (e) => {
					if (isPinching && e.touches.length < 2) {
						isPinching = false;
						if (scale < 1) {
							resetZoom();
						} else {
							const rect = lbImgEl.getBoundingClientRect();
							const vw = window.innerWidth;
							const vh = window.innerHeight;
							const imgW = rect.width; const imgH = rect.height;
							const maxPanX = Math.max(0, (imgW * scale - vw) / 2 / scale);
							const maxPanY = Math.max(0, (imgH * scale - vh) / 2 / scale);
							panX = Math.max(-maxPanX, Math.min(maxPanX, panX));
							panY = Math.max(-maxPanY, Math.min(maxPanY, panY));
							applyTransform(true);
						}
						return;
					}
					if (scale <= 1.05) {
						wrap.style.transition = 'transform 0.25s ease';
						if (Math.abs(singleDeltaY) > 100) {
							wrap.style.transform = `translateY(${singleDeltaY > 0 ? '100vh' : '-100vh'}) scale(0.5)`;
							setTimeout(closeLb, 200);
						} else {
							resetZoom();
						}
					}
				}, { passive: true });

				lbImgEl.addEventListener('dblclick', (e) => {
					e.preventDefault();
					if (scale > 1.05) {
						resetZoom();
					} else {
						const rect = lbImgEl.getBoundingClientRect();
						const cx = e.clientX - rect.left - rect.width / 2;
						const cy = e.clientY - rect.top - rect.height / 2;
						scale = 2.5;
						panX = -cx * 1.5;
						panY = -cy * 1.5;
						applyTransform(true);
					}
				});

				let lastTap = 0;
				lbImgEl.addEventListener('touchend', (e) => {
					if (e.touches.length > 0 || isPinching) return;
					const now = Date.now();
					if (now - lastTap < 300) {
						e.preventDefault();
						if (scale > 1.05) {
							resetZoom();
						} else {
							scale = 2.5;
							panX = 0; panY = 0;
							applyTransform(true);
						}
						lastTap = 0;
					} else {
						lastTap = now;
					}
				});

				overlay.addEventListener('transitionend', () => {
					if (overlay!.classList.contains('active') && !hintShown) {
						hint.style.opacity = '1';
						setTimeout(() => { hint.style.opacity = '0'; hintShown = true; }, 2000);
					}
				}, { once: true });
			}

			const lbImg = overlay.querySelector('.lb-wrap img') as HTMLImageElement;
			const lbCaption = overlay.querySelector('.lb-caption') as HTMLElement;

			document.querySelectorAll('.prose img, .hero-image img').forEach((img) => {
				const el = img as HTMLImageElement;
				el.style.cursor = 'zoom-in';
				el.addEventListener('click', (e) => {
					e.preventDefault();
					e.stopPropagation();
					lbImg.src = el.src;
					lbImg.alt = el.alt;
					const alt = el.alt;
					if (alt && alt !== 'undefined' && !alt.startsWith('http')) {
						lbCaption.textContent = alt;
						lbCaption.style.display = 'block';
					} else {
						lbCaption.style.display = 'none';
					}
					overlay!.classList.add('active');
					document.body.style.overflow = 'hidden';
				});
			});
		}

		function initTOC() {
			const nav = document.getElementById('toc-nav');
			const tocEl = document.querySelector('.toc') as HTMLElement;
			const mobileToc = document.getElementById('mobile-toc') as HTMLDetailsElement | null;
			const mobileNav = document.getElementById('mobile-toc-nav');
			if (!nav || !tocEl) return;
			nav.innerHTML = '';
			if (mobileNav) mobileNav.innerHTML = '';

			function positionTOC() {
				const mainEl = document.querySelector('main');
				if (!mainEl || !tocEl) return;
				const mainRect = mainEl.getBoundingClientRect();
				const gap = 20;
				const tocWidth = window.innerWidth < 1360 ? 190 : 220;
				tocEl.style.width = tocWidth + 'px';
				const left = mainRect.left - tocWidth - gap;
				if (left < 8 || window.innerWidth <= 1220) {
					tocEl.style.display = 'none';
					return;
				}
				tocEl.style.display = '';
				tocEl.style.left = left + 'px';
			}

			positionTOC();
			window.addEventListener('resize', positionTOC);

			const prose = document.querySelector('.prose');
			if (prose) {
				const showObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							tocEl.classList.add('visible');
						} else if (entry.boundingClientRect.top > 0) {
							tocEl.classList.remove('visible');
						}
					});
				}, { threshold: 0, rootMargin: '-60px 0px 0px 0px' });
				showObserver.observe(prose);
			}

			const headings = document.querySelectorAll('.prose h2, .prose h3');
			if (headings.length === 0) {
				tocEl.style.display = 'none';
				if (mobileToc) mobileToc.hidden = true;
				return;
			}

			if (mobileToc && headings.length >= 2) {
				mobileToc.hidden = false;
			}

			headings.forEach((heading, i) => {
				if (!heading.id) {
					heading.id = 'heading-' + i;
				}

				const label = heading.textContent?.replace(/#$/, '').trim() || '';
				const tag = heading.tagName.toLowerCase();
				const level = tag === 'h1' ? '1' : tag === 'h2' ? '2' : '3';

				const makeLink = (closeMobile = false) => {
					const link = document.createElement('a');
					link.href = '#' + heading.id;
					link.textContent = label;
					link.className = 'toc-link';
					link.dataset.level = level;
					link.addEventListener('click', (e) => {
						e.preventDefault();
						heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
						history.replaceState(null, '', '#' + heading.id);
						if (closeMobile && mobileToc) mobileToc.open = false;
					});
					return link;
				};

				nav.appendChild(makeLink(false));
				if (mobileNav) mobileNav.appendChild(makeLink(true));

				// Якорная кнопка # для копирования ссылки на раздел
				if (!heading.querySelector('.heading-anchor')) {
					const anchor = document.createElement('button');
					anchor.type = 'button';
					anchor.className = 'heading-anchor';
					anchor.setAttribute('aria-label', `Скопировать ссылку на раздел «${label}»`);
					anchor.title = 'Скопировать ссылку на раздел';
					anchor.textContent = '#';
					anchor.addEventListener('click', async (e) => {
						e.preventDefault();
						e.stopPropagation();
						const url = `${location.origin}${location.pathname}#${heading.id}`;
						history.replaceState(null, '', '#' + heading.id);
						try {
							await navigator.clipboard.writeText(url);
							anchor.textContent = '✓';
							anchor.classList.add('copied');
							setTimeout(() => {
								anchor.textContent = '#';
								anchor.classList.remove('copied');
							}, 1600);
						} catch {}
					});
					heading.appendChild(anchor);
				}
			});

			const links = nav.querySelectorAll('.toc-link');
			const headingEls = Array.from(headings) as HTMLElement[];
			const offset = 100;

			function updateActive() {
				let current = -1;
				for (let i = 0; i < headingEls.length; i++) {
					if (headingEls[i].getBoundingClientRect().top <= offset) {
						current = i;
					} else {
						break;
					}
				}
				links.forEach(l => l.classList.remove('active'));
				if (current >= 0 && links[current]) {
					links[current].classList.add('active');
					links[current].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
				}
			}

			window.addEventListener('scroll', updateActive, { passive: true });
			updateActive();
		}

		initCodeBlocks();
		initLightbox();
		initTOC();
		document.addEventListener('astro:after-swap', () => {
			initCodeBlocks();
			initLightbox();
			initTOC();
		});
	</script>
	</body>
</html>

