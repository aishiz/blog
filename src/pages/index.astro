---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { CATEGORIES as CATEGORY_DEFS } from '../data/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import avatar from '../assets/photo_2026-02-11_16-09-08.jpg';

const allPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function estimateReadingTime(body: string) {
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.round(words / 200));
	return `${minutes} мин`;
}

function formatDate(d: Date) {
	return d.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
}

function pluralPosts(n: number) {
	const mod100 = n % 100;
	const mod10 = n % 10;
	if (mod100 >= 11 && mod100 <= 19) return `${n} статей`;
	if (mod10 === 1) return `${n} статья`;
	if (mod10 >= 2 && mod10 <= 4) return `${n} статьи`;
	return `${n} статей`;
}

const CAT_VAR: Record<string, string> = {
	'фундамент': '--cat-fundament',
	'тулы': '--cat-tools',
	'модели': '--cat-models',
	'хайп': '--cat-hype',
};

const categoriesWithCount = CATEGORY_DEFS.map((c) => ({
	...c,
	count: allPosts.filter((p) => p.data.category === c.key).length,
}));

const featured = allPosts[0];
const rest = allPosts.slice(1);
const recentRest = rest.slice(0, 4);

// «База» — закреплённый маршрут входа в тему: от одного токена к KV-кэшу, квантизации и агентам
const STARTER_SLUGS = ['how-llm-generates-token', 'kv-cache', 'llm-quantization', 'agent-harness'];
const starterPosts = STARTER_SLUGS
	.map((slug) => allPosts.find((p) => p.id === slug))
	.filter(Boolean) as typeof allPosts;

const MARQUEE_TOPICS = [
	'KV-КЭШ', 'MoE', 'КВАНТИЗАЦИЯ', 'АГЕНТЫ', 'ИНФЕРЕНС', 'VLLM',
	'LLM GATEWAY', 'A2A & MCP', 'GPU', 'ТОКЕНЫ', 'ШИЗА',
];

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"description": SITE_DESCRIPTION,
	"url": Astro.site,
	"inLanguage": "ru-RU",
	"author": {
		"@type": "Person",
		"name": "Артемий Мазаев",
		"url": new URL('/about/', Astro.site).toString()
	},
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${Astro.site}blog/?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={`${SITE_TITLE} — Блог об AI, LLM и ML Inference`} description="Блог Артемия об AI-агентах, LLM, ML Inference и квантизации моделей. Статьи, заметки и практический опыт работы с большими языковыми моделями.">
			<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
			<script is:inline>
				// Хостинг отдаёт главную с кодом 200 на любой несуществующий URL (SPA-фоллбэк).
				// Пока это не выключено в настройках, уводим такие адреса на страницу 404 с noindex.
				if (location.pathname !== '/' && location.pathname !== '/index.html') location.replace('/404.html');
			</script>
		</BaseHead>
	</head>
	<body>
		<Header />
		<ScrollToTop />
		<main>
			<section class="hero" aria-label="О блоге">
				<div class="hero-avatar">
					<Image src={avatar} alt="Артемий — автор блога ЭЙ АЙ ШИЗ" width={280} height={280} />
				</div>
				<div class="hero-text">
					<span class="hero-badge">Блог Артемия</span>
					<h1>У вас начнётся <span class="glitch gradient-text" data-text="ШИЗА">ШИЗА</span></h1>
					<p>
						AI&#8209;Agents, LLM, ML&nbsp;Inference и ночные сессии с&nbsp;vLLM.
						Пишу о&nbsp;технологиях, делюсь опытом и&nbsp;шизой.
					</p>
					<div class="hero-actions">
						<a href="/blog/" class="cta-button">
							Все статьи
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14M12 5l7 7-7 7" />
							</svg>
						</a>
						<a href="/about/" class="secondary-button">Обо мне</a>
						<span class="post-count">{pluralPosts(allPosts.length)}</span>
					</div>
				</div>
			</section>

			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					{[0, 1].map(() => (
						<span class="marquee-chunk">
							{MARQUEE_TOPICS.map((t) => (
								<span class="marquee-item">{t}<span class="marquee-dot">·</span></span>
							))}
						</span>
					))}
				</div>
			</div>

			<section class="recent-posts" aria-label="Свежая статья">
				<div class="section-header">
					<h2>Свежее</h2>
					<a href="/blog/" class="see-all">Смотреть все &rarr;</a>
				</div>
				<div class="posts-grid">
					{featured && (
						<BlogCard
							title={featured.data.title}
							description={featured.data.description}
							date={formatDate(featured.data.pubDate)}
							slug={featured.id}
							heroImage={featured.data.heroImage}
							readingTime={estimateReadingTime(featured.body ?? '')}
							category={featured.data.category}
							featured={true}
						/>
					)}
				</div>
			</section>

			<section class="categories-section" aria-label="Рубрики блога">
				<div class="section-header">
					<h2>Рубрики</h2>
					<a href="/blog/" class="see-all">Весь архив &rarr;</a>
				</div>
				<div class="categories-grid">
					{categoriesWithCount.map((c) => (
						<a href={`/blog/category/${c.slug}/`} class="cat-card" style={`--cc: var(${c.varName});`}>
							<div class="cat-head">
								<h3>{c.title}</h3>
								<span class="cat-count">{pluralPosts(c.count)}</span>
							</div>
							<p>{c.blurb}</p>
						</a>
					))}
				</div>
			</section>

			<section class="starter" aria-label="С чего начать">
				<div class="section-header">
					<h2>База — с чего начать</h2>
				</div>
				<div class="starter-list">
					{starterPosts.map((post, i) => {
						const cVar = post.data.category ? CAT_VAR[post.data.category] : undefined;
						return (
							<a href={`/blog/${post.id}/`} class="starter-row">
								<span class="starter-num">{String(i + 1).padStart(2, '0')}</span>
								<span class="starter-title">{post.data.title}</span>
								{post.data.category && cVar && (
									<span class="starter-cat" style={`--sc: var(${cVar})`}>{post.data.category}</span>
								)}
								<span class="starter-time">{estimateReadingTime(post.body ?? '')}</span>
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 12h14M12 5l7 7-7 7" />
								</svg>
							</a>
						);
					})}
				</div>
			</section>

			<section class="recent-posts" aria-label="Ещё статьи">
				<div class="section-header">
					<h2>Ещё статьи</h2>
					<a href="/blog/" class="see-all">Смотреть все &rarr;</a>
				</div>
				<div class="posts-grid">
					{recentRest.map((post) => (
						<BlogCard
							title={post.data.title}
							description={post.data.description}
							date={formatDate(post.data.pubDate)}
							slug={post.id}
							heroImage={post.data.heroImage}
							readingTime={estimateReadingTime(post.body ?? '')}
							category={post.data.category}
						/>
					))}
				</div>
			</section>

			<section class="tg-banner" aria-label="Telegram канал">
				<div class="tg-banner-text">
					<span class="tg-kicker">Telegram · @ai_shizz</span>
					<h2>Короткие заметки, разборы и шиза — быстрее, чем в блоге</h2>
					<p>Новые статьи, ночные бенчмарки vLLM, обзоры моделей и честные выводы без маркетинговой воды.</p>
				</div>
				<a href="https://t.me/ai_shizz" target="_blank" rel="noopener" class="cta-button tg-btn">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
					Подписаться
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		position: relative;
		max-width: var(--max-width-wide);
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Амбиентное свечение за шапкой — как на about.astro */
	main::before {
		content: "";
		position: absolute;
		top: -80px;
		left: 0;
		right: 0;
		height: 760px;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(42% 38% at 22% 5%, rgba(255, 107, 43, 0.13), transparent 62%),
			radial-gradient(42% 38% at 78% 10%, rgba(201, 70, 255, 0.12), transparent 62%);
	}

	main > * {
		position: relative;
		z-index: 1;
	}

	/* ---- HERO ---- */
	.hero {
		display: flex;
		flex-direction: row !important;
		align-items: center;
		gap: 3rem;
		padding: 4rem 0 3rem;
	}

	.hero-avatar {
		position: relative;
		flex-shrink: 0;
	}

	.hero-avatar::before {
		content: "";
		position: absolute;
		inset: -12px;
		border-radius: 26px;
		background: radial-gradient(120% 120% at 30% 10%, rgba(255, 107, 43, 0.28), rgba(201, 70, 255, 0.18) 50%, transparent 72%);
		filter: blur(16px);
		z-index: -1;
		opacity: 0.85;
	}

	.hero-avatar img {
		display: block;
		position: relative;
		width: 200px;
		height: 200px;
		border-radius: 20px;
		object-fit: cover;
		border: 2px solid var(--border-light);
	}

	.hero-avatar::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 20px;
		padding: 1.5px;
		background: linear-gradient(150deg, var(--accent), rgba(201, 70, 255, 0.6) 55%, transparent 85%);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	.hero-text {
		flex: 1;
		min-width: 0;
	}

	.hero-badge {
		display: inline-block;
		padding: 0.25rem 0.8rem;
		background: var(--accent-glow);
		border: 1px solid rgba(255, 107, 43, 0.25);
		border-radius: 100px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent-light);
		margin-bottom: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.hero-text h1 {
		font-size: 2.6rem;
		font-weight: 900;
		line-height: 1.1;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--accent), var(--accent-yellow));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* ---- Глитч на «ШИЗА» ---- */
	.glitch {
		position: relative;
		display: inline-block;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		-webkit-text-fill-color: currentColor;
		background: none;
	}

	.glitch::before {
		color: #23d5e8;
		animation: glitch-a 5.5s infinite steps(1);
	}

	.glitch::after {
		color: var(--accent-magenta);
		animation: glitch-b 5.5s infinite steps(1);
	}

	@keyframes glitch-a {
		0%, 92.9%, 96.1%, 100% { opacity: 0; }
		93% { opacity: 0.85; transform: translate(-4px, 2px); clip-path: inset(10% 0 55% 0); }
		94% { opacity: 0.85; transform: translate(3px, -1px); clip-path: inset(60% 0 12% 0); }
		95% { opacity: 0.85; transform: translate(-2px, 1px); clip-path: inset(30% 0 40% 0); }
	}

	@keyframes glitch-b {
		0%, 92.9%, 96.1%, 100% { opacity: 0; }
		93% { opacity: 0.85; transform: translate(4px, -2px); clip-path: inset(50% 0 20% 0); }
		94% { opacity: 0.85; transform: translate(-3px, 2px); clip-path: inset(8% 0 65% 0); }
		95% { opacity: 0.85; transform: translate(2px, -1px); clip-path: inset(70% 0 5% 0); }
	}

	.hero-text p {
		font-size: 1.05rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		max-width: 480px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.5rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
		color: white;
		border-radius: 100px;
		font-weight: 700;
		font-size: 0.88rem;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 20px rgba(255, 107, 43, 0.2);
		flex-shrink: 0;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 28px rgba(255, 107, 43, 0.3);
		color: white;
	}

	.secondary-button {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.3rem;
		background: var(--bg-card);
		color: var(--text-secondary);
		border: 1px solid var(--border);
		border-radius: 100px;
		font-weight: 600;
		font-size: 0.88rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.secondary-button:hover {
		border-color: var(--border-light);
		color: var(--text);
		transform: translateY(-2px);
	}

	.post-count {
		font-size: 0.82rem;
		color: var(--text-muted);
		font-weight: 500;
		margin-left: 0.25rem;
		font-variant-numeric: tabular-nums;
	}

	/* ---- Бегущая строка ---- */
	.marquee {
		overflow: hidden;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 0.55rem 0;
		margin-bottom: 2.5rem;
		mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 32s linear infinite;
	}

	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	.marquee-chunk {
		display: flex;
		flex-shrink: 0;
	}

	.marquee-item {
		display: inline-flex;
		align-items: center;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.marquee-dot {
		margin: 0 1.1rem;
		color: var(--accent);
	}

	@keyframes marquee {
		to { transform: translateX(-50%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track { animation: none; }
		.glitch::before, .glitch::after { animation: none; }
	}

	/* ---- Секции ---- */
	.recent-posts,
	.categories-section,
	.starter {
		padding: 0 0 2.5rem;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.section-header h2 {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 1.35rem;
		font-weight: 800;
	}

	.section-header h2::before {
		content: "";
		width: 4px;
		height: 1.05em;
		border-radius: 4px;
		background: linear-gradient(var(--accent), var(--accent-secondary));
		flex-shrink: 0;
	}

	.see-all {
		font-size: 0.85rem;
		color: var(--accent-light);
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.see-all:hover {
		color: var(--accent);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	/* ---- Карточки рубрик ---- */
	.categories-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.cat-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.2rem 1.35rem 1.2rem 1.5rem;
		border-radius: var(--radius);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--cc) 8%, transparent), transparent 55%),
			var(--bg-card);
		border: 1px solid var(--border);
		text-decoration: none;
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.cat-card::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: linear-gradient(var(--cc), color-mix(in srgb, var(--cc) 35%, transparent));
		transition: width 0.2s ease;
	}

	.cat-card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--cc) 55%, var(--border));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--cc) 35%, transparent), 0 8px 24px color-mix(in srgb, var(--cc) 14%, transparent);
	}

	.cat-card:hover::before {
		width: 5px;
	}

	.cat-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.cat-card h3 {
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--text);
		margin: 0;
	}

	.cat-count {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--cc);
		padding: 0.16rem 0.6rem;
		border-radius: 100px;
		background: color-mix(in srgb, var(--cc) 12%, var(--bg-secondary));
		border: 1px solid color-mix(in srgb, var(--cc) 35%, transparent);
		font-variant-numeric: tabular-nums;
	}

	.cat-card p {
		margin: 0;
		font-size: 0.86rem;
		color: var(--text-secondary);
		line-height: 1.55;
	}

	/* ---- База ---- */
	.starter-list {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-card);
	}

	.starter-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.95rem 1.4rem;
		text-decoration: none;
		border-bottom: 1px solid var(--border);
		transition: background 0.2s ease;
	}

	.starter-row:last-child {
		border-bottom: none;
	}

	.starter-row:hover {
		background: var(--bg-card-hover);
	}

	.starter-num {
		font-size: 1.25rem;
		font-weight: 900;
		background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	.starter-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text);
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
