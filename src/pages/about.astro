---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { SITE_TITLE } from '../consts';
import aboutPhoto from '../assets/photo_2026-02-11_16-07-52.jpg';

const SKILLS = ["AI Agents", "LLM", "ML Inference", "vLLM", "Quantization", "RAG", "Foundation Models"];

const PRODUCTS = [
	{
		key: "agents",
		name: "Evolution AI Agents",
		tag: "Автономные агенты",
		desc: "Фреймворк для сборки и интеграции мультиагентных систем прямо в рабочие процессы — от прототипа до прода.",
		accent: "var(--accent)",
		mine: "делал сам",
	},
	{
		key: "models",
		name: "Evolution Foundation Models",
		tag: "Модели по API",
		desc: "Готовые LLM и AI-модели по API — проприетарные и open-source (GigaChat, OpenAI, QWEN, GLM), без своей инфраструктуры.",
		accent: "var(--accent-secondary)",
		mine: "тестил сам",
	},
	{
		key: "inference",
		name: "Evolution ML Inference",
		tag: "Инференс · GPU",
		desc: "Инфраструктура инференса и деплоя AI/LLM-моделей: автоскейлинг на GPU, throughput и экономика на проде.",
		accent: "var(--accent-yellow)",
		mine: "запускал сам",
	},
	{
		key: "rag",
		name: "Evolution Managed RAG",
		tag: "RAG под ключ",
		desc: "RAG на данных организации как готовый сервис: индексация, retrieval и генерация из коробки, а не сборка руками.",
		accent: "var(--accent-magenta)",
		mine: "тестил сам",
	},
];

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Артемий Мазаев",
	"url": new URL('/about', Astro.site).toString(),
	"image": new URL(aboutPhoto.src, Astro.site).toString(),
	"jobTitle": "Руководитель AI Factory",
	"worksFor": {
		"@type": "Organization",
		"name": "AI Factory"
	},
	"description": "Руководитель AI Factory, AI-инженер, автор блога ЭЙ АЙ ШИЗ. Отвечаю за продукты Evolution AI Agents, Evolution Foundation Models, Evolution ML Inference и Evolution Managed RAG — тестировал их сам, запускал модели, собирал агентов. Специализируюсь на AI-агентах, LLM, ML Inference и квантизации моделей.",
	"alumniOf": {
		"@type": "EducationalOrganization",
		"name": "МАИ (Московский авиационный институт)"
	},
	"knowsAbout": SKILLS,
	"sameAs": ["https://t.me/ai_shizz", "https://github.com/mr8bit"]
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Главная", "item": Astro.site?.toString() },
		{ "@type": "ListItem", "position": 2, "name": "Обо мне", "item": new URL('/about', Astro.site).toString() }
	]
};
---

<html lang="ru">
	<head>
		<BaseHead title={`Обо мне — ${SITE_TITLE}`} description="Артемий Мазаев — руководитель AI Factory, AI-инженер и автор блога ЭЙ АЙ ШИЗ. Отвечаю за продукты Evolution AI Agents, Evolution Foundation Models, Evolution ML Inference и Evolution Managed RAG — тестировал сам, запускал модели, делал агентов.">
			<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		</BaseHead>
	</head>

	<body>
		<Header />
		<ScrollToTop />
		<main>
			<section class="about-hero" aria-label="Обо мне">
				<div class="about-photo">
					<Image src={aboutPhoto} alt="Артемий Мазаев" width={280} height={420} />
				</div>
				<div class="about-intro">
					<span class="label">Обо мне</span>
					<h1>Меня зовут Артемий, и&nbsp;у&nbsp;вас начнётся <span class="highlight glitch" data-text="ШИЗА">ШИЗА</span></h1>

					<div class="role-badge">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>
						<span><strong>Руководитель</strong> AI&nbsp;Factory</span>
					</div>

					<p class="lead">
						AI&nbsp;Agents, Foundation&nbsp;Models, ML&nbsp;Inference, Managed&nbsp;RAG.
						Был продактом этих продуктов, дорос до руководителя AI&nbsp;Factory&nbsp;— но тестил их сам,
						модели запускал сам, агентов делал сам.
					</p>
					<div class="about-actions">
						<a href="/blog" class="cta-button">
							Читать блог
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
						</a>
						<div class="social-links">
							<a href="https://t.me/ai_shizz" target="_blank" rel="noopener" class="social-link" title="Telegram канал">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
							</a>
							<a href="https://github.com/mr8bit" target="_blank" rel="noopener" class="social-link" title="GitHub">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.98 5.24.98 11.5c0 4.87 3.16 9.03 7.55 10.5.55.1.75-.24.75-.53 0-.26-.01-1.13-.02-2.05-3.07.67-3.72-1.3-3.72-1.3-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.7-1.48-2.45-.28-5.02-1.22-5.02-5.44 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.92 0 0 .92-.29 3.02 1.13a10.5 10.5 0 0 1 2.75-.37c.93 0 1.87.13 2.75.37 2.1-1.42 3.02-1.13 3.02-1.13.6 1.52.22 2.64.11 2.92.7.77 1.13 1.75 1.13 2.95 0 4.23-2.58 5.16-5.04 5.43.39.34.74 1.01.74 2.04 0 1.47-.01 2.66-.01 3.02 0 .29.2.64.76.53 4.38-1.47 7.54-5.63 7.54-10.5C23.02 5.24 18.27.5 12 .5z"/></svg>
							</a>
						</div>
					</div>
					<div class="skills-row">
						{SKILLS.map((s) => <span class="skill-chip">{s}</span>)}
					</div>
				</div>
			</section>

			<section class="stats">
				<div class="stat-card accent" style="--sc: var(--accent);">
					<span class="stat-value">6+</span>
					<span class="stat-label">Лет в индустрии</span>
				</div>
				<div class="stat-card" style="--sc: var(--accent-secondary);">
					<span class="stat-value">4</span>
					<span class="stat-label">Продукта в проде</span>
				</div>
				<div class="stat-card" style="--sc: var(--accent-yellow);">
					<span class="stat-value">DS &rarr; Lead</span>
					<span class="stat-label">За 2 года</span>
				</div>
				<div class="stat-card" style="--sc: var(--accent-magenta);">
					<span class="stat-value">МАИ</span>
					<span class="stat-label">Образование</span>
				</div>
			</section>

			<section class="products" aria-label="Продукты, за которые я отвечаю">
				<div class="products-head">
					<span class="label">AI&nbsp;Factory</span>
					<h2>Продукты, за которые я отвечаю</h2>
					<p class="products-sub">Продукты платформы Evolution&nbsp;AI&nbsp;Factory. Был продактом, дорос до руководителя&nbsp;— и всё это тестил сам, модели запускал сам, агентов делал сам.</p>
				</div>
				<div class="products-grid">
					{PRODUCTS.map((p) => (
						<article class="product-card" style={`--pa: ${p.accent};`}>
							<div class="product-icon">
								{p.key === "agents" && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="10" x="3" y="11" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><path d="M8 16h.01"/><path d="M16 16h.01"/></svg>
								)}
								{p.key === "models" && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
								)}
								{p.key === "inference" && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
								)}
								{p.key === "rag" && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
								)}
							</div>
							<div class="product-body">
								<span class="product-tag">{p.tag}</span>
								<h3>{p.name}</h3>
								<p>{p.desc}</p>
							</div>
							<span class="product-mine">{p.mine}</span>
						</article>
					))}
				</div>
			</section>

			<section class="bio">
				<h2>Кто я такой?</h2>
				<p>
					Закончил <strong>МАИ</strong> по специальности «Системы управления летательным аппаратом».
					Потом ушёл в аспирантуру по прикладной математике — пишу диссертацию на тему
					<em>«Применение методов машинного обучения в системах управления летательными аппаратами»</em>.
					Аспирантуру закончил, диссертацию пока не защитил — в процессе. Там же веду пары.
				</p>
			</section>

			<section class="life-section">
				<h2>Кто я по жизни?</h2>
				<div class="life-list">
					<div class="life-item">
						<div class="life-marker"></div>
						<div class="life-content">
							<p>По жизни я — <strong>ШИЗ</strong>: работать 24/7, «подбирать» vLLM аргументами для запуска, чтобы получить +5% производительности — это про меня. По ночам сижу в issue репозитория vLLM и достаю китайцев тупыми вопросами.</p>
						</div>
					</div>
					<div class="life-item">
						<div class="life-marker fire"></div>
						<div class="life-content">
							<p>Если не работал с 9 до 4 утра, значит, не работал вовсе.</p>
							<blockquote>Живи, вкалывай, вкалывай, вкалывай, сдохни!</blockquote>
						</div>
					</div>
					<div class="life-item">
						<div class="life-marker"></div>
						<div class="life-content">
							<p>За <strong>6 лет</strong> работы ни разу не был в отпуске. Брал отпуск и работал дальше.</p>
						</div>
					</div>
					<div class="life-item">
						<div class="life-marker"></div>
						<div class="life-content">
							<p>Создаю агентов чисто <strong>по фану</strong>, а потом их в прод запускают.</p>
						</div>
					</div>
					<div class="life-item">
						<div class="life-marker"></div>
						<div class="life-content">
							<p>Лютый гавнокодер, поэтому, когда вышел <strong>Cursor</strong>, стал его фанатом. Имею 10+ «гавно-вайбкодерских IDE».</p>
						</div>
					</div>
					<div class="life-item">
						<div class="life-marker fun"></div>
						<div class="life-content">
							<p>Мой принцип — <strong>Just For Fun</strong>. Половина фичей в продуктах была придумана в баре и иногда во время ночной шизы. Сел делать — и пока не сделаю, не иду спать.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="achievements-section">
				<h2>Чего добился?</h2>
				<div class="achievements-grid">
					<div class="ach-card">
						<span class="ach-num">01</span>
						<p>Возглавил линейку продуктов AI&nbsp;Factory</p>
					</div>
					<div class="ach-card">
						<span class="ach-num">02</span>
						<p>Сделал LLM доступнее в РФ</p>
					</div>
					<div class="ach-card">
						<span class="ach-num">03</span>
						<p>За 2 года от DS до руководителя AI&#8209;продуктов</p>
					</div>
				</div>
			</section>

			<section class="closing-cta">
				<h2>Дочитал(а) до конца?</h2>
				<p>Тогда тебе точно в блог — там всё то же самое, но по делу.</p>
				<a href="/blog" class="cta-button">
					Читать блог
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		position: relative;
		max-width: var(--max-width-wide);
		margin: 0 auto;
		padding: 0 2rem 4rem;
	}

	/* амбиентное свечение за верхом страницы — глубина без флеша */
	main::before {
		content: "";
		position: absolute;
		top: -80px;
		left: 0;
		right: 0;
		height: 1200px;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(42% 34% at 27% 2%, rgba(255, 107, 43, 0.13), transparent 60%),
			radial-gradient(42% 34% at 75% 6%, rgba(201, 70, 255, 0.13), transparent 60%),
			radial-gradient(92% 55% at 50% -14%, rgba(201, 70, 255, 0.05), transparent 72%);
	}

	main > section {
		position: relative;
		z-index: 1;
	}

	/* ---- HERO ---- */
	.about-hero {
		display: flex;
		flex-direction: row !important;
		align-items: flex-start;
		gap: 3rem;
		padding: 3.5rem 0 2.5rem;
	}

	.about-photo {
		flex-shrink: 0;
		position: relative;
	}

	/* мягкое градиентное свечение за фото */
	.about-photo::before {
		content: "";
		position: absolute;
		inset: -14px;
		border-radius: 28px;
		background: radial-gradient(120% 120% at 30% 10%, rgba(255, 107, 43, 0.28), rgba(201, 70, 255, 0.18) 45%, transparent 70%);
		filter: blur(18px);
		z-index: -1;
		opacity: 0.85;
	}

	.about-photo img {
		display: block;
		width: 260px;
		height: auto;
		border-radius: 20px;
		object-fit: cover;
		border: 2px solid var(--border-light);
		position: relative;
	}

	/* тонкая градиентная рамка поверх фото */
	.about-photo::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 20px;
		padding: 1.5px;
		background: linear-gradient(150deg, var(--accent), rgba(201, 70, 255, 0.6) 55%, transparent 85%);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	.about-intro {
		flex: 1;
		min-width: 0;
		padding-top: 0.25rem;
	}

	.label {
		display: inline-block;
		padding: 0.25rem 0.8rem;
		background: var(--accent-glow);
		border: 1px solid rgba(255, 107, 43, 0.25);
		border-radius: 100px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent-light);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		margin-bottom: 0.85rem;
	}

	.about-intro h1 {
		font-size: clamp(2rem, 4vw, 2.9rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.02em;
		margin-bottom: 1rem;
	}

	.highlight {
		background: linear-gradient(135deg, var(--accent), var(--accent-yellow));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* ---- Роль: Руководитель AI Factory ---- */
	.role-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 1rem;
		margin-bottom: 1.15rem;
		border-radius: 100px;
		background: linear-gradient(135deg, rgba(255, 107, 43, 0.14), rgba(201, 70, 255, 0.12));
		border: 1px solid rgba(201, 70, 255, 0.32);
		color: var(--text);
		font-size: 0.95rem;
		font-weight: 600;
	}

	.role-badge svg {
		color: var(--accent-light);
		flex-shrink: 0;
	}

	.role-badge strong {
		font-weight: 800;
		background: linear-gradient(135deg, var(--accent-light), var(--accent-secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* ---- Глитч на «ШИЗА» (как на главной) ---- */
	.glitch {
		position: relative;
		display: inline-block;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		-webkit-text-fill-color: currentColor;
		background: none;
	}

	.glitch::before {
		color: #23d5e8;
		animation: glitch-a 5.5s infinite steps(1);
	}

	.glitch::after {
		color: var(--accent-magenta);
		animation: glitch-b 5.5s infinite steps(1);
	}

	@keyframes glitch-a {
		0%, 92.9%, 96.1%, 100% { opacity: 0; }
		93% { opacity: 0.85; transform: translate(-4px, 2px); clip-path: inset(10% 0 55% 0); }
		94% { opacity: 0.85; transform: translate(3px, -1px); clip-path: inset(60% 0 12% 0); }
		95% { opacity: 0.85; transform: translate(-2px, 1px); clip-path: inset(30% 0 40% 0); }
	}

	@keyframes glitch-b {
		0%, 92.9%, 96.1%, 100% { opacity: 0; }
		93% { opacity: 0.85; transform: translate(4px, -2px); clip-path: inset(50% 0 20% 0); }
		94% { opacity: 0.85; transform: translate(-3px, 2px); clip-path: inset(8% 0 65% 0); }
		95% { opacity: 0.85; transform: translate(2px, -1px); clip-path: inset(70% 0 5% 0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch::before, .glitch::after { animation: none; }
		.about-photo::before { animation: none; }
	}

	.lead {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.75;
		margin-bottom: 1.5rem !important;
	}

	.about-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
