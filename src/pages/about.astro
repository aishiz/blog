const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Артемий Мазаев',
	url: new URL('/about/', Astro.site).toString(),
	image: new URL(aboutPhoto.src, Astro.site).toString(),
	jobTitle: 'Руководитель AI Factory',
	worksFor: {
		'@type': 'Organization',
		name: 'Cloud.ru (Evolution AI Factory)',
		url: 'https://cloud.ru',
	},
	description:
		'Руководитель AI Factory в Cloud.ru, AI-инженер, спикер GoCloud и AI DevTools Conf, ментор и автор блога ЭЙ АЙ ШИЗ. Отвечаю за продукты Evolution AI Agents, Evolution Foundation Models, Evolution ML Inference и Evolution Managed RAG.',
	alumniOf: {
		'@type': 'EducationalOrganization',
		name: 'МАИ (Московский авиационный институт)',
	},
	knowsAbout: SKILLS,
	sameAs: [
		'https://t.me/ai_shizz',
		'https://github.com/mr8bit',
		'https://getmentor.dev/mentor/artemiy-mazaev-5067',
		'https://southhub.ru/speakers/artemij-mazaev/',
	],
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Главная', item: Astro.site?.toString() },
		{ '@type': 'ListItem', position: 2, name: 'Обо мне', item: new URL('/about/', Astro.site).toString() },
	],
};
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead
			title={`Обо мне — ${SITE_TITLE}`}
			description="Артемий Мазаев — руководитель AI Factory в Cloud.ru, AI-инженер, спикер GoCloud и AI DevTools Conf, автор блога ЭЙ АЙ ШИЗ. Продукты, выступления, доклады и подкасты."
		>
			<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		</BaseHead>
	</head>

	<body>
		<Header />
		<ScrollToTop />
		<main>
			<section class="about-hero" aria-label="Обо мне">
				<div class="about-photo-col">
					<div class="about-photo">
						<Image src={aboutPhoto} alt="Артемий Мазаев" width={280} height={420} loading="eager" fetchpriority="high" />
					</div>
					<div class="photo-meta">
						<span class="status-dot"></span>
						<span>Cloud.ru · AI Factory · МАИ</span>
					</div>
				</div>

				<div class="about-intro">
					<span class="label">Обо мне</span>
					<h1>Меня зовут Артемий, и&nbsp;у&nbsp;вас начнётся <span class="highlight glitch" data-text="ШИЗА">ШИЗА</span></h1>

					<div class="role-row">
						<div class="role-badge">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>
							<span><strong>Руководитель</strong> AI&nbsp;Factory · Cloud.ru</span>
						</div>
						<a href="#talks" class="speaker-pill">
							🎤 {TALKS.length} выступлений и подкастов ↓
						</a>
					</div>

					<p class="lead">
						AI&nbsp;Agents, Foundation&nbsp;Models, ML&nbsp;Inference, Managed&nbsp;RAG.
						Был продактом этих продуктов, дорос до руководителя AI&nbsp;Factory&nbsp;— но тестил их сам,
						модели запускал сам, агентов делал сам.
					</p>

					<div class="about-actions">
						<a href="/blog/" class="cta-button">
							Читать блог
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
						</a>
						<a href="#talks" class="secondary-button">Выступления</a>
						<div class="social-links">
							<a href="https://t.me/ai_shizz" target="_blank" rel="noopener" class="social-link" title="Telegram канал @ai_shizz" aria-label="Telegram канал">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
							</a>
							<a href="https://github.com/mr8bit" target="_blank" rel="noopener" class="social-link" title="GitHub" aria-label="GitHub">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.98 5.24.98 11.5c0 4.87 3.16 9.03 7.55 10.5.55.1.75-.24.75-.53 0-.26-.01-1.13-.02-2.05-3.07.67-3.72-1.3-3.72-1.3-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.7-1.48-2.45-.28-5.02-1.22-5.02-5.44 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.92 0 0 .92-.29 3.02 1.13a10.5 10.5 0 0 1 2.75-.37c.93 0 1.87.13 2.75.37 2.1-1.42 3.02-1.13 3.02-1.13.6 1.52.22 2.64.11 2.92.7.77 1.13 1.75 1.13 2.95 0 4.23-2.58 5.16-5.04 5.43.39.34.74 1.01.74 2.04 0 1.47-.01 2.66-.01 3.02 0 .29.2.64.76.53 4.38-1.47 7.54-5.63 7.54-10.5C23.02 5.24 18.27.5 12 .5z"/></svg>
							</a>
							<a href="https://getmentor.dev/mentor/artemiy-mazaev-5067" target="_blank" rel="noopener" class="social-link" title="GetMentor — менторство по ML / MLOps" aria-label="GetMentor">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
							</a>
						</div>
					</div>

					<div class="skills-row">
						{SKILLS.map((s) => <span class="skill-chip">{s}</span>)}
					</div>
				</div>
			</section>

			<section class="stats" aria-label="Ключевые цифры">
				<div class="stat-card accent" style="--sc: var(--accent);">
					<span class="stat-value">6+</span>
					<span class="stat-label">Лет в индустрии</span>
				</div>
				<div class="stat-card" style="--sc: var(--accent-secondary);">
					<span class="stat-value">4</span>
					<span class="stat-label">AI-продукта в проде</span>
				</div>
				<div class="stat-card" style="--sc: var(--cat-tools);">
					<span class="stat-value">{TALKS.length}+</span>
					<span class="stat-label">Выступлений и подкастов</span>
				</div>
				<div class="stat-card" style="--sc: var(--cat-fundament);">
					<span class="stat-value">{postsCount}</span>
					<span class="stat-label">Разборов в блоге</span>
				</div>
			</section>

			<section class="products" aria-label="Продукты, за которые я отвечаю">
				<div class="section-head">
					<span class="label">Cloud.ru · AI&nbsp;Factory</span>
					<h2>Продукты, за которые я отвечаю</h2>
					<p class="section-sub">
						Линейка платформы Evolution&nbsp;AI&nbsp;Factory. Был продактом, дорос до руководителя&nbsp;—
						и всё это тестил сам, модели запускал сам, агентов делал сам.
					</p>
				</div>
				<div class="products-grid">
					{PRODUCTS.map((p) => (
						<article class="product-card" style={`--pa: ${p.accent};`}>
							<div class="product-top">
								<div class="product-icon">
									{p.key === 'agents' && (
										<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="10" x="3" y="11" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><path d="M8 16h.01"/><path d="M16 16h.01"/></svg>
									)}
									{p.key === 'models' && (
										<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
									)}
									{p.key === 'inference' && (
										<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
