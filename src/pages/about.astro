---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { SITE_TITLE } from '../consts';
import aboutPhoto from '../assets/photo_2026-02-11_16-07-52.jpg';

const postsCount = (await getCollection('blog')).length;

const SKILLS = [
	'AI Agents',
	'A2A & MCP',
	'LLM',
	'ML Inference',
	'vLLM',
	'Quantization',
	'RAG',
	'MLOps',
	'Foundation Models',
];

const PRODUCTS = [
	{
		key: 'agents',
		name: 'Evolution AI Agents',
		tag: 'Автономные агенты',
		desc: 'Платформа для сборки и интеграции мультиагентных систем прямо в рабочие процессы — от прототипа и A2A до прода.',
		accent: 'var(--accent)',
		mine: 'делал сам',
		postHref: '/blog/multi-agent-a2a/',
		postLabel: 'Разбор про агентов и A2A',
	},
	{
		key: 'models',
		name: 'Evolution Foundation Models',
		tag: 'Модели по API',
		desc: 'Готовые LLM и AI-модели по API — проприетарные и open-source (GigaChat, OpenAI, Qwen, GLM), без своей инфраструктуры.',
		accent: 'var(--accent-secondary)',
		mine: 'тестил сам',
		postHref: '/blog/llm-gateway-routing/',
		postLabel: 'Про шлюзы и роутинг',
	},
	{
		key: 'inference',
		name: 'Evolution ML Inference',
		tag: 'Инференс · GPU',
		desc: 'Инфраструктура инференса и деплоя AI/LLM-моделей: автоскейлинг на GPU, Shared GPU, throughput и экономика на проде.',
		accent: 'var(--accent-yellow)',
		mine: 'запускал сам',
		postHref: '/blog/llm_inference_engines_complete_guide/',
		postLabel: 'Гайд по движкам инференса',
	},
	{
		key: 'rag',
		name: 'Evolution Managed RAG',
		tag: 'RAG под ключ',
		desc: 'RAG на данных организации как готовый сервис: индексация, retrieval, reranking и генерация из коробки.',
		accent: 'var(--accent-magenta)',
		mine: 'тестил сам',
		postHref: '/blog/rag-complete-guide/',
		postLabel: 'Полное пособие по RAG',
	},
];

interface Talk {
	title: string;
	event: string;
	year: string;
	kind: 'conf' | 'meetup' | 'podcast';
	kindLabel: string;
	accent: string;
	desc: string;
	primaryUrl: string;
	primaryLabel: string;
	secondaryUrl?: string;
	secondaryLabel?: string;
}

