---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

function formatDate(d: Date) {
	return d.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<html lang="ru">
	<head>
		<BaseHead
			title={`Страница не найдена — ${SITE_TITLE}`}
			description="Такой страницы нет — возможно, ссылка устарела или в адресе опечатка."
			noindex
		/>
	</head>

	<body>
		<Header />
		<ScrollToTop />
		<main>
			<section class="error-hero">
				<span class="code">404</span>
				<h1>Страница потерялась в контексте</h1>
				<p class="lead">Такой страницы нет — ссылка устарела или в адресе опечатка.</p>
				<a href="/" class="cta-button">
					На главную
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
				</a>
			</section>

			<section class="fallback-posts">
				<h2>Может, вам сюда?</h2>
				<div class="posts-grid">
					{posts.map((post) => (
						<BlogCard
							title={post.data.title}
							description={post.data.description}
							date={formatDate(post.data.pubDate)}
							slug={post.id}
							heroImage={post.data.heroImage?.src}
							category={post.data.category}
						/>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--max-width-wide);
		margin: 0 auto;
		padding: 0 2rem 4rem;
	}

	.error-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		padding: 4rem 0 3rem;
	}

	.code {
		font-size: 5rem;
		font-weight: 900;
		line-height: 1;
		background: linear-gradient(135deg, var(--accent), var(--accent-magenta));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.error-hero h1 {
		font-size: 1.5rem;
		font-weight: 800;
		margin: 0;
	}

	.lead {
		font-size: 1rem;
		color: var(--text-secondary);
		margin-bottom: 0.5rem;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.5rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
		color: white;
		border-radius: 100px;
		font-weight: 700;
		font-size: 0.88rem;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 20px rgba(255, 107, 43, 0.2);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 28px rgba(255, 107, 43, 0.3);
		color: white;
	}

	.fallback-posts h2 {
		font-size: 1.2rem;
		font-weight: 800;
		margin-bottom: 1.25rem;
		text-align: center;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.posts-grid { grid-template-columns: 1fr; }
		.code { font-size: 3.5rem; }
	}
</style>
