---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const STOP_WORDS = new Set([
		'как', 'что', 'это', 'для', 'или', 'при', 'без', 'под', 'над', 'про', 'через', 'после',
		'его', 'она', 'они', 'них', 'все', 'всё', 'вот', 'тут', 'там', 'где', 'кто', 'чем',
		'почему', 'когда', 'если', 'тоже', 'только', 'очень', 'просто', 'разбираю', 'разбираем',
		'разбор', 'статья', 'модель', 'модели', 'моделей', 'llm', 'the', 'and', 'for', 'with',
		'how', 'why', 'from', 'into', 'your',
	]);

	const tokenize = (text: string): Set<string> =>
		new Set(
			text
				.toLowerCase()
				.replace(/[^a-zа-яё0-9-]+/gi, ' ')
				.split(/\s+/)
				.filter((w) => w.length >= 3 && !STOP_WORDS.has(w)),
		);

	const posts = (await getCollection('blog'))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	const tokensById = new Map(
		posts.map((p) => [
			p.id,
			{
				title: tokenize(p.data.title),
				desc: tokenize(p.data.description),
			},
		]),
	);

	return posts.map((post, i) => {
		const prevPost = posts[i + 1] ?? null;
		const nextPost = posts[i - 1] ?? null;
		const excludeIds = new Set([post.id, prevPost?.id, nextPost?.id].filter(Boolean));
		const cur = tokensById.get(post.id)!;

		// Умная перелинковка: считаем пересечение ключевых слов (title весит ×3) + бонус за рубрику,
		// чтобы внутренний вес распределялся по всему блогу, а не только на 2 самые свежие статьи.
		const relatedPosts = posts
			.filter((p) => !excludeIds.has(p.id))
			.map((cand) => {
				const ct = tokensById.get(cand.id)!;
				let score = post.data.category && cand.data.category === post.data.category ? 2.5 : 0;
				for (const w of cur.title) {
					if (ct.title.has(w)) score += 3;
					else if (ct.desc.has(w)) score += 1.5;
				}
				for (const w of cur.desc) {
					if (ct.title.has(w)) score += 1.5;
					else if (ct.desc.has(w)) score += 0.6;
				}
				return { post: cand, score };
			})
			.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
			.slice(0, 4)
			.map((x) => x.post);

		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost,
				nextPost,
				relatedPosts,
			},
		};
	});
}

interface Props {
	post: CollectionEntry<'blog'>;
	prevPost: CollectionEntry<'blog'> | null;
	nextPost: CollectionEntry<'blog'> | null;
	relatedPosts: CollectionEntry<'blog'>[];
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await render(post);

const words = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = `${Math.max(1, Math.round(words / 200))} мин чтения`;
---

<BlogPost
	{...post.data}
	readingTime={readingTime}
	wordCount={words}
	prevPost={prevPost ? { title: prevPost.data.title, slug: prevPost.id } : undefined}
	nextPost={nextPost ? { title: nextPost.data.title, slug: nextPost.id } : undefined}
	relatedPosts={relatedPosts.map((p) => ({
		title: p.data.title,
		description: p.data.description,
		slug: p.id,
		heroImage: p.data.heroImage,
		category: p.data.category,
		pubDate: p.data.pubDate,
	}))}
>
	<Content />
</BlogPost>
