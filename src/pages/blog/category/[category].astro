---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import ScrollToTop from '../../../components/ScrollToTop.astro';
import { CATEGORIES } from '../../../data/categories';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORIES.map((cat) => ({
		params: { category: cat.slug },
		props: {
			cat,
			posts: posts
				.filter((p) => p.data.category === cat.key)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { cat, posts } = Astro.props;

function estimateReadingTime(body: string) {
	const words = body.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.round(words / 200));
	return `${minutes} мин`;
}

function formatDate(d: Date) {
	return d.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
}

const pageTitle = `Рубрика «${cat.title}» — ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": pageTitle,
	"description": cat.blurb,
	"url": canonicalURL.toString(),
	"isPartOf": {
		"@type": "WebSite",
		"name": SITE_TITLE,
		"url": Astro.site?.toString()
	},
	"breadcrumb": {
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Главная", "item": Astro.site?.toString() },
			{ "@type": "ListItem", "position": 2, "name": "Статьи", "item": new URL('/blog', Astro.site).toString() },
			{ "@type": "ListItem", "position": 3, "name": cat.title, "item": canonicalURL.toString() }
		]
	}
};
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={pageTitle} description={cat.blurb}>
			<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
		</BaseHead>
	</head>
	<body>
		<Header />
		<ScrollToTop />
		<main>
			<div class="page-header">
				<p class="breadcrumb"><a href="/blog">Статьи</a> / {cat.title}</p>
				<div class="page-title-row">
					<h1>{cat.title}</h1>
					<span class="count">{posts.length}</span>
				</div>
				<p>{cat.blurb}</p>
				<div class="filter-row" role="group" aria-label="Рубрики">
					<a class="filter-chip" href="/blog">Все</a>
					{CATEGORIES.map((c) => (
						<a
							class:list={['filter-chip', { active: c.slug === cat.slug }]}
							href={`/blog/category/${c.slug}/`}
							style={`--chip: var(${c.varName})`}
						>
							{c.title}
						</a>
					))}
				</div>
			</div>

			<div class="posts-grid">
				{posts.map((post) => (
					<BlogCard
						title={post.data.title}
						description={post.data.description}
						date={formatDate(post.data.pubDate)}
						slug={post.id}
						heroImage={post.data.heroImage?.src}
						readingTime={estimateReadingTime(post.body ?? '')}
						category={post.data.category}
					/>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--max-width-wide);
		margin: 0 auto;
		padding: 0 2rem 4rem;
	}

	.page-header {
		padding: 2.5rem 0 2rem;
	}

	.breadcrumb {
		font-size: 0.82rem;
		color: var(--text-muted);
		margin: 0 0 0.75rem;
	}

	.breadcrumb a {
		color: var(--text-muted);
	}

	.breadcrumb a:hover {
		color: var(--accent-light);
	}

	.page-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.page-title-row h1 {
		font-size: 1.9rem;
		font-weight: 800;
		margin: 0;
	}

	.count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.6rem;
		height: 1.6rem;
		padding: 0 0.5rem;
		border-radius: 100px;
		background: var(--bg-card);
		border: 1px solid var(--border);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-muted);
	}

	.page-header > p {
		color: var(--text-secondary);
		font-size: 0.95rem;
		max-width: 640px;
		margin-bottom: 1.5rem;
	}

	.filter-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.filter-chip {
		padding: 0.4rem 1rem;
		border-radius: 100px;
		border: 1px solid var(--border);
		background: var(--bg-card);
		color: var(--text-secondary);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.filter-chip:hover {
		border-color: var(--chip, var(--accent));
		color: var(--text);
	}

	.filter-chip.active {
		background: color-mix(in srgb, var(--chip, var(--accent)) 16%, var(--bg-card));
		border-color: var(--chip, var(--accent));
		color: var(--chip, var(--accent));
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.posts-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 650px) {
		main { padding: 0 1.25rem 3rem; }
		.posts-grid { grid-template-columns: 1fr; }
		.page-title-row h1 { font-size: 1.5rem; }
	}
</style>
