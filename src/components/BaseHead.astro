---
import '../styles/global.css';
// Самохостинг вместо Google Fonts: убирает render-blocking запрос к стороннему
// origin и связанный с ним CLS от подмены шрифта (font swap).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, YANDEX_METRIKA_ID, YANDEX_VERIFICATION, GOOGLE_SITE_VERIFICATION } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', publishedTime, modifiedTime, noindex = false } = Astro.props;
const ogImageURL = image ? new URL(image.src, Astro.site) : new URL('/og-default.png', Astro.site);
---

<script is:inline>
(function() {
	var pref = localStorage.getItem('theme-pref') || 'system';
	var resolved;
	if (pref === 'system') {
		resolved = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	} else {
		resolved = pref;
	}
	document.documentElement.setAttribute('data-theme', resolved);
	document.documentElement.setAttribute('data-theme-pref', pref);
	if (resolved === 'dark') {
		document.documentElement.style.background = '#0b0b1e';
		document.documentElement.style.color = '#f0ecff';
	} else {
		document.documentElement.style.background = '#f8f7fc';
		document.documentElement.style.color = '#1a1a2e';
	}
})();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b1e" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f7fc" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={AUTHOR_NAME} />

{YANDEX_VERIFICATION && <meta name="yandex-verification" content={YANDEX_VERIFICATION} />}
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="ru_RU" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

{YANDEX_METRIKA_ID && (
	<Fragment>
		<script is:inline define:vars={{ id: YANDEX_METRIKA_ID }}>
			(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
			m[i].l=1*new Date();
			for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
			k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
			(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

			ym(id, "init", {
				clickmap: true,
				trackLinks: true,
				accurateTrackBounce: true,
			});
		</script>
		<noscript>
			<div>
				<img src={`https://mc.yandex.ru/watch/${YANDEX_METRIKA_ID}`} style="position:absolute; left:-9999px;" alt="" />
			</div>
		</noscript>
	</Fragment>
)}

<slot />
