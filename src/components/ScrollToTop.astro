---
// ponytail: раньше был React-островом с client:load — ради кнопки-переключателя
// это тащило react+jsx-runtime на каждую страницу сайта. Обычный toggle не требует фреймворка.
---

<button id="scroll-to-top" aria-label="Наверх" class="scroll-to-top">
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M18 15l-6-6-6 6" />
	</svg>
</button>

<script>
	const btn = document.getElementById('scroll-to-top') as HTMLButtonElement;

	const onScroll = () => btn.classList.toggle('visible', window.scrollY > 400);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
	.scroll-to-top {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--border-light);
		background: var(--bg-card);
		color: var(--accent-light);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
		z-index: 90;
		transition: all 0.2s ease;
		opacity: 0;
		pointer-events: none;
	}

	.scroll-to-top.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.scroll-to-top:hover {
		background: var(--bg-card-hover);
		border-color: var(--accent);
	}

	@media (max-width: 480px) {
		.scroll-to-top {
			width: 40px;
			height: 40px;
			bottom: 1rem;
			right: 1rem;
		}
	}
</style>
