---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import CommandSearch from './CommandSearch';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const searchPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((p) => ({
		title: p.data.title,
		description: p.data.description,
		slug: p.id,
		category: p.data.category,
		date: p.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'short', day: 'numeric' }),
	}));
---

<header>
	<div class="header-inner">
		<a href="/" class="logo">
			<span class="logo-dot"></span>
			<span class="logo-text">{SITE_TITLE}</span>
		</a>
		<div class="header-right">
			<nav class="desktop-nav">
				<HeaderLink href="/">Главная</HeaderLink>
				<HeaderLink href="/blog/">Статьи</HeaderLink>
				<HeaderLink href="/about/">Обо мне</HeaderLink>
			</nav>
			<CommandSearch client:idle posts={searchPosts} />
			<a href="https://t.me/ai_shizz" target="_blank" rel="noopener" class="header-tg" aria-label="Telegram канал ЭЙ АЙ ШИЗ" title="Telegram канал @ai_shizz">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
			</a>
			<ThemeToggle />
			<button class="mobile-menu-btn" aria-label="Открыть меню" aria-expanded="false">
				<svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="18" x2="21" y2="18" />
				</svg>
				<svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
		</div>
	</div>
	<nav class="mobile-nav">
		<HeaderLink href="/">Главная</HeaderLink>
		<HeaderLink href="/blog/">Статьи</HeaderLink>
		<HeaderLink href="/about/">Обо мне</HeaderLink>
	</nav>
</header>

<script>
	const btn = document.querySelector('.mobile-menu-btn');
	const mobileNav = document.querySelector('.mobile-nav');
	const iconMenu = btn?.querySelector('.icon-menu') as HTMLElement | null;
	const iconClose = btn?.querySelector('.icon-close') as HTMLElement | null;

	btn?.addEventListener('click', () => {
		const isOpen = mobileNav?.classList.toggle('open');
		btn.setAttribute('aria-expanded', String(!!isOpen));
		if (iconMenu) iconMenu.style.display = isOpen ? 'none' : 'block';
		if (iconClose) iconClose.style.display = isOpen ? 'block' : 'none';
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--header-bg);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		max-width: var(--max-width-wide);
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--text);
		font-weight: 800;
		font-size: 1rem;
		letter-spacing: -0.01em;
	}

	.logo:hover {
		color: var(--text);
	}

	.logo-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
		box-shadow: 0 0 8px rgba(255, 107, 43, 0.4);
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.header-tg {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--border);
		background: var(--bg-card);
		color: var(--text-muted);
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.header-tg:hover {
		color: #2aabee;
		border-color: rgba(42, 171, 238, 0.45);
	}

	:global(.cmd-trigger:hover) {
		border-color: var(--border-light) !important;
		color: var(--text) !important;
	}

	.mobile-menu-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: none;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		border-radius: 8px;
		transition: all 0.2s ease;
	}

	.mobile-menu-btn:hover {
		color: var(--text);
		background: var(--bg-card);
	}

	.mobile-nav {
		display: none;
		flex-direction: column;
		padding: 0;
		border-top: 1px solid var(--border);
		background: var(--header-bg-solid);
		overflow: hidden;
		max-height: 0;
		transition: max-height 0.3s ease, padding 0.3s ease;
	}

	@media (max-width: 720px) {
		:global(.cmd-trigger-label),
		:global(.cmd-trigger-kbd) {
			display: none !important;
		}
		:global(.cmd-trigger) {
			width: 34px !important;
			justify-content: center !important;
			padding: 0 !important;
		}
	}

	@media (max-width: 600px) {
		.header-inner {
			padding: 0 1rem;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu-btn {
			display: flex;
			width: 44px;
			height: 44px;
		}

		.mobile-nav {
			display: flex;
			padding: 0 1rem;
			gap: 0.25rem;
		}

		.mobile-nav.open {
			max-height: 200px;
			padding: 0.5rem 1rem 1rem;
		}
	}
</style>
